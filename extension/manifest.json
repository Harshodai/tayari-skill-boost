{
  "manifest_version": 3,
  "name": "Job Tayari Browser Companion",
  "version": "3.0.0",
  "description": "A candidate-controlled Job Tayari side panel for understanding job pages, preparing applications, and keeping reviewable career workflows in sync.",
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "https://tayari.app/*",
      "https://www.tayari.app/*",
      "https://tayari-skill-boost.lovable.app/*",
      "http://localhost:5173/*",
      "http://localhost:8080/*",
      "http://localhost:8083/*",
      "http://localhost:8085/*"
    ]
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "sidePanel",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.workday.com/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://api.tayari.app/*",
    "https://tayari.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs/search/*",
        "https://*.indeed.com/viewjob*",
        "https://*.greenhouse.io/*",
        "https://*.workday.com/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Job Tayari side panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
