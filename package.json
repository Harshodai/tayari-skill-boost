    "security:baseline": "node scripts/security_scan.mjs --update-baseline",
    "promotion:gate": "bash scripts/production_promotion_gate.sh",
    "desktop:dev": "concurrently -k \"pnpm dev\" \"wait-on http://127.0.0.1:8080 && cross-env ELECTRON_START_URL=http://127.0.0.1:8080 electron .\"",
    "desktop:build": "node scripts/build-desktop.mjs --mac --arm64",
    "desktop:build:mac": "node scripts/build-desktop.mjs --mac --arm64",
    "desktop:build:mac:release": "bash scripts/require_clean_worktree.sh && node scripts/build-desktop.mjs --mac --arm64 --config.mac.notarize=true",
    "desktop:build:win": "node scripts/build-desktop.mjs --win --x64",
    "desktop:build:linux": "node scripts/build-desktop.mjs --linux --x64",
    "desktop:build:all": "node scripts/build-desktop.mjs --mac --arm64 --win --x64 --linux --x64",
    "extension:package": "node scripts/package-extension.mjs",
    "extension:validate": "node scripts/validate-extension.mjs",
    "test:extension": "node --test extension/tests/*.integration.mjs",
    "docker:smoke": "bash scripts/local-docker-smoke.sh",
    "docker:down": "bash scripts/local-docker-smoke.sh --down"
