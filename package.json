  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "bash scripts/require_clean_worktree.sh && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint src",
    "lint:budget": "node scripts/lint_warning_budget.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --reporter=list",
