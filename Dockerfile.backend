# Go backend
FROM golang:alpine AS builder

WORKDIR /build

ENV GOTOOLCHAIN=auto

# Install deps
RUN apk add --no-cache git

# Copy go files
COPY backend/go/go.mod backend/go/go.sum ./
RUN go mod download

COPY backend/go/ ./

# Build
RUN CGO_ENABLED=0 GOOS=linux go build -o /tayari-server ./cmd/server

# Production stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /tayari-server .

EXPOSE 8080

CMD ["./tayari-server"]
