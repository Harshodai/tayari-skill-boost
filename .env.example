# ========================================
# Tayari Skill Boost - Environment Variables Example
# ========================================
# This file matches the main `docker-compose.yml` (self-hosted Supabase +
# Go gateway + Python AI engine + frontend + Redis/Celery + Ollama + Caddy).
#
# The database is the full self-hosted Supabase stack in `supabase-local/`
# (Postgres + GoTrue auth + PostgREST + Kong + Realtime + Storage + Studio),
# merged into this compose project via `include:` — NOT a separate,
# optional thing anymore, and NOT a bare Postgres image. It has its own
# `.env` file (`supabase-local/.env`) with its own required secrets; copy
# `supabase-local/.env.example` there and fill it in too.
#
# POSTGRES_PASSWORD and JWT_SECRET below MUST exactly match the same-named
# values in `supabase-local/.env`. Compose resolves each compose file's
# ${VAR} references against its own env file, so these are two independent
# values that only end up equal if you set them to match by hand. A
# mismatched JWT_SECRET doesn't error — every login just silently looks
# like an invalid token, since GoTrue signs with supabase-local's secret and
# go-backend verifies with this one (internal/auth/supabase.go).

# ========================================
# Docker Compose Profiles — REQUIRED
# ========================================
# Every service in docker-compose.yml declares a profile. Without one set,
# `docker compose up -d` starts ZERO containers, silently, no error.
# This makes `docker compose up -d --build` just work; `--profile dev` on the
# command line does the same thing if you'd rather not set it here.
COMPOSE_PROFILES=dev

# ========================================
# Database — Supabase's Postgres, not a standalone one
# ========================================
# Must match supabase-local/.env's POSTGRES_PASSWORD exactly (see header
# note above). Username is always "postgres" and the database is always
# "postgres" — that's Supabase's own fixed convention, not configurable
# here; DATABASE_URL is assembled from just this one var for every service
# that needs it (go-backend, python-ai, celery-*).
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# ========================================
# Auth mode — self-hosted JWT vs Supabase
# ========================================
# These two must agree — one toggles the frontend build, the other toggles
# the Go gateway's auth backend. Default is Supabase mode: the frontend
# talks to local Supabase Auth (GoTrue, via Kong) directly for
# register/login, and go-backend only verifies the JWTs GoTrue issues —
# it never issues tokens itself in this mode.
VITE_USE_SELF_HOSTED=false
# Optional for local unpacked-extension direct messaging. The secure page bridge
# remains the primary path; never commit a user-specific extension ID here.
VITE_EXTENSION_ID=
USE_SUPABASE=true

# JWT_SECRET — required, must match supabase-local/.env's JWT_SECRET (see
# header note above). Any random 32+ char string, same value in both files.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Python AI service boundary. In production the Python service rejects every
# non-health request without this shared secret; generate a unique random value
# and set the same value for Go and Python. Never commit the real token.
AI_INTERNAL_TOKEN=
# Optional distinct token for Go/Python /metrics scraping. If blank, the
# services fall back to AI_INTERNAL_TOKEN; never expose this endpoint publicly.
METRICS_TOKEN=
# json is the production-safe default for request telemetry.
LOG_FORMAT=json

# Approval signing key used by the final browser-action guard. Generate a
# separate random value for each deployment; production refuses to start when
# it is missing. Never commit the real value.
APPROVAL_SIGNING_KEY=
# CodeAct executes generated Python and is disabled in production unless this
# explicit opt-in is true. Keep false unless the worker is separately isolated.
ENABLE_CODEACT=false
# Container bind defaults to all interfaces for health checks; narrow it for
# local/host-network runs when required.
BIND_HOST=

# Set ENV=production for a production Compose run. The Python service fails
# closed when ENV=production but AI_INTERNAL_TOKEN or APPROVAL_SIGNING_KEY is missing.
ENV=development

# SUPABASE_SERVICE_ROLE_KEY — optional. When set on go-backend, account
# deletion (DELETE /api/v1/account) also calls GoTrue's admin API
# (DELETE /auth/v1/admin/users/{id}) — the sanctioned deletion path that
# revokes the user's sessions/refresh tokens. Copy SERVICE_ROLE_KEY from
# supabase-local/.env. When unset, the direct SQL delete is used instead
# (the deleted auth.users row still invalidates tokens via the VerifyToken
# existence check). Treat it as a secret — never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase Kong gateway + anon key — copy ANON_KEY from
# supabase-local/.env (its default matches the value below out of the box).
# Leave KONG_HTTP_PORT at its supabase-local/.env default (8000) unless you
# changed it there too.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
VITE_SUPABASE_PROJECT_ID=
# Same anon key, read server-side by go-backend (internal/config — currently
# unused by any handler, reserved for future Supabase Admin API calls).
SUPABASE_URL=http://kong:8000
# Browser-reachable Supabase/Kong origin used by the extension PKCE flow.
# Keep the internal SUPABASE_URL above for containers; do not use kong:8000 in browser code.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8010
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# To go back to the old self-hosted-JWT-only mode with no Supabase Auth at
# all, flip VITE_USE_SELF_HOSTED=true / USE_SUPABASE=false — the Go
# register/login endpoints still work standalone, but you lose Studio,
# Storage, Realtime, and Supabase's own RLS/auth.uid().

# ========================================
# Frontend (Vite build arg — served on host port 8083)
# ========================================
VITE_API_URL=/api

# ========================================
# Host ports — override any of these if they collide with another project
# already running on this machine (see README.md's Ports table and the
# collision note below it). Changing one here only moves the *host* side of
# the mapping; container-internal ports and any other place that assumes
# the old default (ALLOWED_ORIGINS, FRONTEND_URL, extension default config,
# OAuth callback URLs below) need updating by hand to match.
# ========================================
FRONTEND_PORT=8083
GO_BACKEND_PORT=8085
PYTHON_AI_PORT=8002
REDIS_PORT=6380
OLLAMA_PORT=11435
FLOWER_PORT=5555

# python-ai (FastAPI) process model. Defaults below match the historical
# behavior (single-process, live reload on file change) — right for local
# dev, wrong for a real deployment: --reload has no benefit outside dev and
# silently caps the whole service at one worker process regardless of load.
# For a prod/eval deployment, set UVICORN_RELOAD=false.
UVICORN_RELOAD=true
UVICORN_WORKERS=2

# Proxies allowed to supply X-Forwarded-For/X-Real-IP. Keep blank for direct
# local development; production compose requires an explicit value.
TRUSTED_PROXY_CIDRS=

# ========================================
# LLM Provider (Go gateway proxies to the Python AI engine)
# ========================================
# Leave everything below blank for mock-fallback mode — AI endpoints now
# return an explicit 503 ai_service_unavailable (LLMNotConfiguredError),
# NOT placeholder text; see CLAUDE.md's "AI endpoints" gotcha.
# Ollama: LLM_PROVIDER=ollama (or blank) + LLM_BASE_URL containing "ollama"
# or "11434" is auto-detected; LLM_MODEL defaults to "llama3.1" — pull it
# first with `docker exec tayari-ollama ollama pull <model>`, Ollama ships
# with zero models by default.
# OpenRouter: set LLM_PROVIDER=openrouter + OPENROUTER_API_KEY (below) —
# LLM_BASE_URL/LLM_API_KEY/LLM_MODEL are NOT read for this branch, only
# OPENROUTER_API_KEY + optional OPENROUTER_MODEL (default openai/gpt-4o-mini)
# are (see backend/python/app/services/llm_service.py build_provider()).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_CHEAP=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_DEEP=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_SMART=
OPENROUTER_MODEL_DEEP=

# --- Optional model routing -------------------------------------------------
# The governed runtime supports named tiers: cheap (bulk extraction), fast
# (interactive ranking/drafting), smart (optimization and planning), deep
# (high-stakes reasoning/evaluation), and hermes (explicit Hermes runtime).
# Setting a tier override routes that tier to a different model within the same
# provider. Empty overrides preserve the unsuffixed model exactly as before.
# There is no implicit cross-provider failover: provider failures are surfaced
# and counted rather than hidden behind fabricated output.
# Works for LLM_MODEL, OPENROUTER_MODEL, and NVIDIA_NIM_MODEL.
# OPENROUTER_MODEL_CHEAP=openai/gpt-5-nano
# OPENROUTER_MODEL_FAST=openai/gpt-5-mini
# OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4-6
# OPENROUTER_MODEL_DEEP=anthropic/claude-opus-4-7

# ========================================
# LLM Observability & Cost Controls (Langfuse)
# ========================================
# Optional Langfuse tracing (WP-06). Operates fail-open: if keys are unset or network
# is unreachable, LLM inferences continue uninterrupted with zero user-facing errors.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Maximum estimated daily LLM spend in USD per user before logging warnings and incrementing
# telemetry counters (llm_daily_cost_budget_exceeded_total). Inferences continue normally.
MAX_DAILY_LLM_COST_USD=0.50


# ========================================
# Tayari Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ========================================

# ========================================
# Celery Flower Dashboard (dev only)
# ========================================
# REQUIRED to start celery-flower — no default. docker-compose.yml fails
# closed (won't start the service) if either is unset or empty.
FLOWER_USER=admin_test
FLOWER_PASSWORD=test_pw_1785481863

# ========================================
# E2E tests (Playwright)
# ========================================
# REQUIRED — e2e/smoke.spec.ts throws at import without it. The suite
# registers a user with this password; any value works for local runs.
# ponytail: non-production placeholder only. Real CI/production credentials
# must come from secrets, never from this committed file.
E2E_TEST_PASSWORD=localdev-placeholder-not-secret
# Only enable for disposable local/CI E2E runs; staging/production rejects it.
TAYARI_E2E_TEST_MODE=false

# ========================================
# Optional integrations (safe to leave blank — features degrade, don't crash)
# ========================================
# Binary OmniSaveAI media mirroring is disabled by default. Enabling it requires
# an audited public-media fetcher, malware scanner, object store, retention and
# deletion controls, and staging evidence; this flag alone is insufficient.
OMNISAVE_MEDIA_MIRROR_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
SENDGRID_API_KEY=
# Production notification delivery is fail-closed: set a real SMTP host,
# sender identity, and HTTPS/mailto unsubscribe target before enabling email.
SMTP_HOST=
SMTP_PORT=587
NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_UNSUBSCRIBE_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Live verification is disabled by default; enable only in a gated runner.
ALLOW_LIVE_PROVIDER_VERIFY=false
VERIFY_REQUIRED_PROVIDERS=go-gateway,python-ai,llm,queue,supabase
# Dedicated disposable test mailbox token; never use a personal mailbox token.
GOOGLE_TEST_ACCESS_TOKEN=

# Job-search scraping (Hermes) + web-search providers
# Optional, explicitly gated public research providers. Never use private-account credentials.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v1
APIFY_API_TOKEN=
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_RESEARCH_ACTOR_ID=
APIFY_ALLOWED_ACTORS=
# Candidate-controlled Tay Workspace plan/review loop; no external submission authority.
CAPABILITY_WORKSPACE_TASK_CONTROL=true
CAPABILITY_WORKSPACE_EXTERNAL_RESEARCH=false
CAPABILITY_WORKSPACE_EXTERNAL_RESEARCH_FIRECRAWL=false
CAPABILITY_WORKSPACE_EXTERNAL_RESEARCH_APIFY=false
# Optional outbound A2A federation; requires explicit peer allowlisting and signed requests.
A2A_FEDERATION_SECRET=
A2A_ALLOWED_PEERS=
CAPABILITY_INTEGRATION_A2A_FEDERATION=false
SERPAPI_API_KEY=
# Crawl4AI is excluded from the core image; enable only in a separately audited worker.
ENABLE_CRAWL4AI=false
CRAWL4AI_BASE_URL=
HERMES_AGENT_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes3:8b

# Browser Automation Agent. The core image uses Playwright-backed form automation;
# the optional browser-use agent is absent by default and fails closed if invoked.
ORQ_API_KEY=
ORQ_MODEL=alibaba/qwen3.6-flash
ORQ_BASE_URL=https://api.orq.ai/v3/router
# Computer runtime: inprocess runs Playwright in-process (default, zero behavior
# change); docker selects per-run container isolation on a bigger host.
COMPUTER_RUNTIME=inprocess
# Docker image for COMPUTER_RUNTIME=docker; the service defaults to this when blank.
COMPUTER_DOCKER_IMAGE=mcr.microsoft.com/playwright/python:v1.49.1
# Vision grounding model override; blank falls back to LLM_MODEL, fail-closed when none set.
VISION_GROUNDING_MODEL=

# ========================================
# Go gateway rate limiting + Redis (best-effort, fails open to in-memory)
# ========================================
# REDIS_URL feeds the per-user AI sliding-window limiter in
# backend/go/internal/api/middleware_rate_limit.go (also read as REDIS_ADDR;
# REDIS_URL wins when both are set). Local default points at the compose
# `redis` service — safe placeholder, not a secret.
REDIS_URL=redis://redis:6379/0
# Requests per user per minute on LLM-heavy AI proxy endpoints; 429 +
# Retry-After past the limit. Gateway default is 30 when unset/invalid.
RATE_LIMIT_PER_USER_PER_MIN=30

# ========================================
# CORS / URLs — host ports match the Docker Compose setup in README.md,
# NOT `bun run dev`'s Vite dev server (see CLAUDE.md gotchas for that split)
# ========================================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8083
FRONTEND_URL=http://localhost:8083

# ========================================
# Caddy reverse proxy (only used if you run the `caddy` service)
# ========================================
CADDY_HTTP_PORT=8090
CADDY_HTTPS_PORT=8443
CADDY_DOMAIN=
CADDY_EMAIL=admin@tayari.app

# ========================================
# Social Auth (Optional — Get from provider consoles)
# ========================================

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8085/api/auth/google/callback
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
