# Tayari Resume Optimizer - Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgres://tayari:tayari_dev@localhost:5432/tayari?sslmode=disable

# AI Service (Python backend)
AI_SERVICE_URL=http://localhost:8000

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change-me-to-a-random-256-bit-string

# LLM API Keys (at least one is required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Frontend
VITE_API_URL=http://localhost:8080/api
VITE_USE_SELF_HOSTED=true

# Deployment
DOMAIN=tayari.app

# Local LLM (Ollama) — set these to use fully local AI, no API keys needed
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=hermes3:8b

# Example Docker Ollama setup:
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=hermes3:8b

# To initialize Ollama with the model after docker-compose up:
# docker exec -it tayari-ollama ollama pull hermes3:8b
# Or run: ./backend/python/ollama_init.sh

# --- Hermes scraping layer (env-gated; leave blank to disable; free ATS APIs work without keys) ---
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# APIFY_API_TOKEN=apify_api_xxx
# SERPAPI_API_KEY=xxx
# CRAWL4AI_BASE_URL=                # blank = in-process AsyncWebCrawler
# --- Hermes LLM tier (OpenAI-compatible; e.g. local Ollama hermes3:8b) ---
# HERMES_AGENT_URL=http://ollama:11434/v1
# HERMES_API_KEY=
# HERMES_MODEL=hermes3:8b
# --- Celery / Redis ---
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=postgres://tayari:tayari_dev@localhost:5432/tayari?sslmode=disable
# SCRAPE_CACHE_TTL_SECONDS=3600
