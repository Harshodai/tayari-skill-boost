# Tayari Skill Boost - Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=tayari

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase (self-hosted or cloud)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to true to use self-hosted Supabase
VITE_USE_SELF_HOSTED=true
# API URL for self-hosted setup
VITE_API_URL=http://localhost:8000

# Cloud Supabase (Backup/Production)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend
# Database URL (via Supabase pooler)
DATABASE_URL=postgres://postgres:your-password@localhost:54322/postgres?sslmode=disable

# Frontend
# URL where the frontend is running
FRONTEND_URL=http://localhost:5173

# Social Auth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
