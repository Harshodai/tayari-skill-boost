# ========================================
# Tayari Skill Boost - Environment Variables Example
# ========================================
# This file matches the main `docker-compose.yml` (Postgres + Go gateway +
# Python AI engine + frontend + Redis/Celery + Ollama + Caddy).
# It does NOT configure the separate, optional self-hosted Supabase stack in
# `supabase-local/` — that stack has its own `.env`, unrelated to this one.

# ========================================
# Docker Compose Profiles — REQUIRED
# ========================================
# Every service in docker-compose.yml declares a profile. Without one set,
# `docker compose up -d` starts ZERO containers, silently, no error.
# This makes `docker compose up -d --build` just work; `--profile dev` on the
# command line does the same thing if you'd rather not set it here.
COMPOSE_PROFILES=dev

# ========================================
# Database (Postgres) — read directly by docker-compose.yml
# ========================================
# Defaults below match docker-compose.yml's own fallback values. Only change
# these if you specifically need non-default local DB credentials.
POSTGRES_USER=tayari
POSTGRES_PASSWORD=tayari_dev
POSTGRES_DB=tayari
# DATABASE_URL is assembled by docker-compose.yml from the three vars above
# for every service that needs it (go-backend, python-ai, celery-*) — you do
# not need to set it separately for local Docker use.

# ========================================
# Auth mode — self-hosted JWT vs Supabase
# ========================================
# These two must agree — one toggles the frontend build, the other toggles
# the Go gateway's auth backend.
VITE_USE_SELF_HOSTED=true
USE_SUPABASE=false

# JWT_SECRET — required. Any random 32+ char string for local dev.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Only needed if USE_SUPABASE=true / VITE_USE_SELF_HOSTED=false (a real, cloud
# Supabase project — not the local supabase-local/ stack):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ========================================
# Frontend (Vite build arg — served on host port 8083)
# ========================================
VITE_API_URL=/api

# ========================================
# LLM Provider (Go gateway proxies to the Python AI engine)
# ========================================
# Leave all four blank for mock-fallback mode (endpoints still respond, but
# with placeholder text — see CLAUDE.md's "AI endpoints" gotcha).
# Ollama: LLM_BASE_URL containing "ollama" or "11434" is auto-detected.
# OpenRouter: set LLM_PROVIDER=openrouter + LLM_BASE_URL + LLM_API_KEY + LLM_MODEL.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ========================================
# Optional integrations (safe to leave blank — features degrade, don't crash)
# ========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
SENDGRID_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Job-search scraping (Hermes) + web-search providers
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
SERPAPI_API_KEY=
CRAWL4AI_BASE_URL=
HERMES_AGENT_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes3:8b

# Browser Automation Agent (browser-use + Playwright) router provider
ORQ_API_KEY=
ORQ_MODEL=alibaba/qwen3.6-flash
ORQ_BASE_URL=https://api.orq.ai/v3/router

# ========================================
# CORS / URLs — host ports match the Docker Compose setup in README.md,
# NOT `bun run dev`'s Vite dev server (see CLAUDE.md gotchas for that split)
# ========================================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8083
FRONTEND_URL=http://localhost:8083

# ========================================
# Caddy reverse proxy (only used if you run the `caddy` service)
# ========================================
CADDY_HTTP_PORT=8090
CADDY_HTTPS_PORT=8443
CADDY_DOMAIN=
CADDY_EMAIL=admin@tayari.app

# ========================================
# Social Auth (Optional — Get from provider consoles)
# ========================================

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8085/api/auth/google/callback
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
