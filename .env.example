# ========================================
# Tayari Skill Boost - Environment Variables Example
# ========================================

# ========================================
# Docker Compose Configuration
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=postgres

# ========================================
# Frontend Configuration (Vite)
# ========================================

# IMPORTANT: Set to 'true' for local Docker development (enables backend proxy for Auth)
VITE_USE_SELF_HOSTED=true

# Self-Hosted Supabase URLs (LOCAL DEVELOPMENT - DEFAULT)
VITE_SUPABASE_URL=http://localhost:8008
VITE_API_URL=http://localhost:8085/api

# VITE_SUPABASE_PUBLISHABLE_KEY is used by the frontend Supabase client
# For local development, use the demo anon key:
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Cloud Supabase (for production - ONLY if VITE_USE_SELF_HOSTED=false)
VITE_SUPABASE_PROJECT_ID=your-project-id

# Legacy/Backup: VITE_SUPABASE_ANON_KEY is used in docker-compose as a fallback
# Keep it in sync with VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# ========================================
# Backend Configuration (Go Service)
# ========================================

# JWT Secret (must match Supabase JWT secret)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Database URL - for unified docker-compose, use internal hostname 'db'
# The docker-compose connects directly to supabase-db:5432
DATABASE_URL=postgres://postgres:your-secure-password@db:5432/postgres?sslmode=disable

# ========================================
# OpenRouter LLM Configuration
# ========================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# Backend Supabase connection (internal Docker network)
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4175,http://localhost:8083

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:4175

# ========================================
# Social Auth (Optional - Get from provider consoles)
# ========================================

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
