# Public endpoint
PUBLIC_DOMAIN=jobs.example.com
PUBLIC_ORIGIN=https://jobs.example.com
CADDY_EMAIL=ops@example.com
APP_VERSION=aws-canary

# Existing Supabase project used for Auth and PostgreSQL migrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id
DATABASE_URL=replace-me

# Generate unique values with: openssl rand -hex 32
JWT_SECRET=replace-me
AI_INTERNAL_TOKEN=replace-me
APPROVAL_SIGNING_KEY=replace-me
TAYARI_API_KEY=replace-me

# Optional provider integrations. Keep empty unless needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
SERPAPI_API_KEY=
SENTRY_DSN=

# Explicit safety boundary. Do not change to true for the canary.
AUTONOMOUS_SUBMIT_ENABLED=false
