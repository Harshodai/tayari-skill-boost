# Public endpoint
PUBLIC_DOMAIN=jobs.example.com
PUBLIC_ORIGIN=https://jobs.example.com
CADDY_EMAIL=ops@example.com
APP_VERSION=aws-canary

# Immutable release images. Resolve registry digests before deployment; mutable tags are rejected.
REDIS_IMAGE=registry.example.com/library/redis@sha256:replace-me
PYTHON_API_IMAGE=registry.example.com/tayari/python-ai@sha256:replace-me
WORKER_IMAGE=registry.example.com/tayari/worker@sha256:replace-me
GATEWAY_IMAGE=registry.example.com/tayari/gateway@sha256:replace-me
FRONTEND_IMAGE=registry.example.com/tayari/frontend@sha256:replace-me
CADDY_IMAGE=registry.example.com/library/caddy@sha256:replace-me

# Existing Supabase project used for Auth and PostgreSQL migrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id
DATABASE_URL=replace-me

# Generate unique values with: openssl rand -hex 32
JWT_SECRET=replace-me
AI_INTERNAL_TOKEN=replace-me
APPROVAL_SIGNING_KEY=replace-me
TAYARI_API_KEY=replace-me
TRUSTED_PROXY_CIDRS=replace-me
LLM_PROVIDER=openrouter
LLM_MODEL_FAST=replace-me
LLM_MODEL_SMART=replace-me

# Optional provider integrations. Keep empty unless needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
SERPAPI_API_KEY=
SENTRY_DSN=

# Explicit safety boundary. Do not change to true for the canary.
AUTONOMOUS_SUBMIT_ENABLED=false
