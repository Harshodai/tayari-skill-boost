{
  email {$CADDY_EMAIL:admin@tayari.app}
}

{$CADDY_DOMAIN:http://localhost:8080} {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # SUPABASE_ORIGIN is only needed when Supabase sits behind this edge as
    # a self-hosted stack (its own direct-to-browser calls need connect-src
    # to include that origin, or the frontend image's own CSP fix — see
    # nginx.conf — is silently overwritten by this proxied response header).
    # Leave unset for hosted Supabase; https://*.supabase.co already covers it.
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.tayari.app {$SUPABASE_ORIGIN:}"
    -Server
  }

  reverse_proxy /api/* go-backend:8080 {
    header_up X-Request-ID {http.request.id}
  }
  reverse_proxy /flower/* celery-flower:5555
  reverse_proxy frontend:80

  log {
    output file /data/logs/access.log
  }
}
