FROM python:3.11-slim-bookworm

WORKDIR /app

# System deps: WeasyPrint libs (kept parity with the web image so export
# tasks work) + curl for healthchecks. Playwright's Chromium deps are
# installed by `playwright install --with-deps` below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf2.0-0 \
    libxml2 \
    libxslt1.1 \
    shared-mime-info \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# PLAYWRIGHT_BROWSERS_PATH must be set BEFORE `playwright install` runs — see
# the matching comment in ../Dockerfile for why (installs land in the wrong
# directory otherwise and every browser call fails at runtime).
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
ENV HOME=/app

# Crawl4AI depends on Playwright + a Chromium browser. Install the browser
# and its OS deps in one layer so the cache holds across image rebuilds.
RUN python -m playwright install --with-deps chromium

# Non-root user for security
RUN groupadd -g 1001 -r app && useradd -r -u 1001 -g app -d /app -s /sbin/nologin app \
    && mkdir -p /app/.cache/ms-playwright /tmp/playwright \
    && chown -R app:app /app /tmp/playwright

COPY --chown=app:app . .

USER app

# Healthcheck — verify Celery worker is processing
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD celery -A app.celery_app inspect ping --destination celery@$HOSTNAME || exit 1

CMD ["celery", "-A", "app.celery_app:celery_app", "worker", "--loglevel=info", "--concurrency=4", "-Q", "tayari"]